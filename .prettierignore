# deploy.sh pipes this file through jq, which rejects the trailing commas that
# Prettier adds to .jsonc.
cloudflare/wrangler.jsonc

# uv and pytest write a .gitignore inside their own directories, which Prettier
# does not read.
.venv/
.pytest_cache/

# git hides nested worktrees through .git/info/exclude and Playwright MCP output
# through the global ignore file, and Prettier reads neither.
.claude/worktrees/
.worktrees/
.playwright-mcp/
