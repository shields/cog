set -euo pipefail

die() {
    printf 'setup-model-gateway: %s\n' "$*" >&2
    exit 1
}

hosts=
for model in "$@"; do
    case $model in
    claude) hosts+=$'127.0.0.1 api.anthropic.com # cog\n' ;;
    fireworks) hosts+=$'127.0.0.1 api.fireworks.ai # cog\n' ;;
    *) die "unknown model $model; expected claude or fireworks" ;;
    esac
done
[[ -n $hosts ]] || die "expected one or more model names: claude, fireworks"
[[ $(id -u) == 0 ]] || die "run as root"
[[ -r /etc/hosts ]] || die "cannot read /etc/hosts"

while IFS= read -r line; do
    if ! grep -qxF -- "$line" /etc/hosts; then
        [[ -z $(tail -c1 /etc/hosts) ]] || printf '\n' >>/etc/hosts
        printf '%s\n' "$line" >>/etc/hosts
    fi
done <<<"${hosts%$'\n'}"
