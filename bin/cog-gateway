set -euo pipefail

bundle=$HOME/.local/share/cog/main.mjs
[[ -f $bundle ]] || {
    printf 'cog-gateway: %s is missing; run ./provision.sh dev\n' "$bundle" >&2
    exit 1
}

for bun in /opt/homebrew/bin/bun /usr/local/bin/bun; do
    if [[ -x $bun ]]; then
        exec "$bun" "$bundle" "$@"
    fi
done
printf 'cog-gateway: Bun is missing; run ./provision.sh dev\n' >&2
exit 1
